# Rendered at start by the nginx image (envsubst); API_UPSTREAM defaults to http://api:3000.
server {
  listen 8080;
  root /usr/share/nginx/html;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  location /v1/ { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $host; }
  location /health { proxy_pass ${API_UPSTREAM}; }
  location /verify/ { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $host; }
  location / { try_files $uri /index.html; }
}
