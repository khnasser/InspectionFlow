# API
PORT=3000
DATABASE_URL=postgres://inspectionflow_api:inspectionflow_api@localhost:5432/inspectionflow
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/inspectionflow
AUTH_MODE=dev                      # dev | oidc
JWT_DEV_SECRET=change-me-dev-secret-at-least-32-characters
# OIDC (Keycloak) - used when AUTH_MODE=oidc
OIDC_ISSUER=https://keycloak.example.ae/realms/inspectionflow
OIDC_AUDIENCE=inspectionflow-api
# Keycloak JWKS (internal URL if different from the public issuer)
OIDC_JWKS_URL=
# Claim carrying the tenant code (hardcoded-claim mapper per realm). Roles are
# never read from the token; they come from InspectionFlow user_roles.
TENANT_CLAIM=tenant
OIDC_WEB_CLIENT_ID=inspectionflow-web
OIDC_MOBILE_CLIENT_ID=inspectionflow-mobile
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Evidence and report storage
STORAGE_DRIVER=local               # local | s3 (s3 required in production)
STORAGE_LOCAL_DIR=./var/storage
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret-32ch
MAX_UPLOAD_BYTES=26214400
S3_BUCKET=inspectionflow-evidence  # UAE region, SSE-KMS, versioning + Object Lock recommended
S3_REGION=me-central-1
S3_ENDPOINT=                       # set for MinIO / S3-compatible stores
S3_FORCE_PATH_STYLE=false

# PDF reports with QR verification
REPORT_RENDERER=playwright         # playwright (dev) | gotenberg (production)
GOTENBERG_URL=http://localhost:3001
REPORT_WORKER=on                   # run the report worker in this API process
REPORT_WORKER_INTERVAL_MS=5000
VERIFY_BASE_URL=http://localhost:5173   # printed in the QR code
